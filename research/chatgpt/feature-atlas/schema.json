{
  "type": "object",
  "required": [
    "feature_id",
    "source_id",
    "module",
    "capability",
    "source_url",
    "evidence_level",
    "target_status"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{4}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^S[0-9]{2}$"
    },
    "module": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "evidence_level": {
      "enum": [
        "SOURCE_IMPLEMENTED",
        "UI_VISIBLE_ONLY",
        "OFFICIALLY_DOCUMENTED",
        "INFERRED",
        "PROPOSED"
      ]
    },
    "target_status": {
      "enum": [
        "TARGET_STATUS_UNVERIFIED",
        "TARGET_VERIFIED_PRESENT",
        "TARGET_VERIFIED_ABSENT"
      ]
    }
  }
}
